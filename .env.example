# =====================================================================
# PA Platform — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# =====================================================================

# --- App ---------------------------------------------------------------
APP_NAME=PA Platform
APP_ENV=development

# --- CORS --------------------------------------------------------------
# Comma-separated origins allowed to call the backend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ----------------------------------------------------------
# Must match the credentials in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://pa_user:pa_password@localhost:5432/pa_db

# --- Redis -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Wazuh API ---------------------------------------------------------
# Verify the IP after each lab boot:
#   virsh -c qemu:///system net-dhcp-leases default
WAZUH_API_URL=https://192.168.122.75:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=
WAZUH_VERIFY_TLS=false
# Wazuh vulnerability inventory is queried from the Wazuh Indexer. If the
# indexer only listens on the Wazuh server's localhost interface, create an SSH
# tunnel first:
#   ssh -N -L 19200:127.0.0.1:9200 ilyass@192.168.122.75
WAZUH_INDEXER_URL=https://127.0.0.1:19200
WAZUH_INDEXER_USER=readall
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_VERIFY_TLS=false

# --- AWX API -----------------------------------------------------------
AWX_API_URL=http://192.168.122.35:30080
AWX_API_USER=admin
AWX_API_PASSWORD=
# Optional: if set, the backend uses bearer-token auth instead of basic auth.
AWX_API_TOKEN=
AWX_VERIFY_TLS=false

# --- AWX job-template policy ------------------------------------------
# Numeric AWX job-template IDs for each semantic remediation action. Set
# these to the IDs of the approved templates in your AWX. If an action's
# template is left unset, remediation jobs for that action are rejected
# at create time with a clear error.
AWX_TEMPLATE_PACKAGE_UPDATE=
AWX_TEMPLATE_WINDOWS_UPDATE=
AWX_TEMPLATE_SERVICE_RESTART=
AWX_TEMPLATE_CONFIG_CHANGE=

# --- JWT (user auth) ---------------------------------------------------
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- First admin (used by scripts/create_admin.py, idempotent) --------
# The bootstrap script reads these to create roles and the first admin
# user. Safe to re-run; it will not create duplicates.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin@2026!
